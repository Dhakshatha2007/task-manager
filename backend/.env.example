# PostgreSQL connection string.
# Local example:   postgresql://postgres:password@localhost:5432/taskmanager
# Neon example:    postgresql://user:password@ep-xxxx.neon.tech/taskmanager?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager"

# Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET="replace-this-with-a-long-random-secret"

# How long a login token stays valid.
JWT_EXPIRES_IN="7d"

# Port the API server listens on.
PORT=5000

# Comma-separated list of allowed frontend origins (for CORS).
CLIENT_ORIGIN="http://localhost:5173"
